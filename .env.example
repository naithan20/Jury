# Required, both locally and on Vercel: an AI Gateway API key.
# Create one in the Vercel dashboard: project -> AI -> API Keys -> Create Key.
# This uses Vercel's own provider relationship (billed against Vercel's free
# $5/month AI Gateway credit) — no Anthropic/OpenAI/Google key needed.
AI_GATEWAY_API_KEY=

# Optional: override the default model (google/gemini-3.1-flash-lite)
JURY_MODEL=
