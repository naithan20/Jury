# Required, both locally and on Vercel: a free OpenRouter API key.
# Create one at https://openrouter.ai/settings/keys — no credit card needed
# to use free (":free" suffixed / openrouter/free-routed) models.
#
# This is used ONLY for authentication (Authorization header to OpenRouter).
# The model ID (openrouter/free) is hardcoded in src/lib/jury/model.ts and
# is not configurable via environment variable — this is deliberate, to
# rule out any env var ever being mistaken for a model ID.
OPENROUTER_API_KEY=

# Optional emergency stop for the machine-callable agent endpoints —
# POST /api/agent/evaluate (image comparison) and
# POST /api/agent/evaluate-idea (free-text idea/decision evaluation). Both
# are deliberately open with no credential (see either route's doc comment
# for why — a secret can't be part of a publicly-discoverable contract),
# bounded instead by a shared per-IP + global daily quota and a kill switch
# tied to the configured model. Nothing needs to be set here for either to
# work.
#
# Set this to the literal string "false" to disable it instantly without a
# code change/redeploy of application logic. Any other value (or leaving it
# unset) means enabled.
AGENT_PUBLIC_ACCESS_ENABLED=
