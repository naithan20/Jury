# Required, both locally and on Vercel: a free OpenRouter API key.
# Create one at https://openrouter.ai/settings/keys — no credit card needed
# to use free (":free" suffixed / openrouter/free-routed) models.
#
# This is used ONLY for authentication (Authorization header to OpenRouter).
# The model ID (openrouter/free) is hardcoded in src/lib/jury/model.ts and
# is not configurable via environment variable — this is deliberate, to
# rule out any env var ever being mistaken for a model ID.
OPENROUTER_API_KEY=

# Optional. Enables POST /api/agent/evaluate — a machine-callable endpoint
# with the same evaluation engine as the human UI, intended for autonomous
# agents (e.g. via AgentGraph) rather than browsers. Generate any long
# random string (e.g. `openssl rand -hex 32`) and give it to whichever
# agent/system should be allowed to call JURY as a Bearer token:
#   Authorization: Bearer <this value>
#
# If this is unset, /api/agent/evaluate refuses every request with 503
# (fails closed) — it never silently falls back to no auth required. The
# human-facing /api/jury route is unaffected either way and needs no key.
AGENT_API_KEY=
