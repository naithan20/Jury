# Required, both locally and on Vercel: a free Gemini API key.
# Create one at https://aistudio.google.com/apikey — no credit card needed.
# Calls the Gemini Developer API directly (not Vercel AI Gateway, not
# Vertex AI) — this is Google's free tier with no billing account required.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the default model (gemini-2.5-flash-lite)
JURY_MODEL=
